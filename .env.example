# Database: Neon PostgreSQL in cloud (falls back to local SQLite if empty)
# Example: postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# AI Engine: Google Gemini API Key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# YouTube Datacenter Anti-Block (Optional, useful when hosting on Render/Leapcell):
# Paste the text content of your exported cookies.txt here:
YOUTUBE_COOKIES_TEXT=

# Free Rotating Proxy (Optional, e.g. from Webshare.io):
PROXY_URL=

# Storage Management (Neon 500MB Free Tier Optimization):
RETENTION_DAYS=15

# Optional Free Object Storage (Cloudflare R2 10GB free tier / AWS S3):
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
